# Copy to .env.local for local dev; set the same keys in Vercel → Settings → Environment Variables.
# Every backend feature degrades gracefully when its keys are missing.

NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Ask Dharma (B2)
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=
GEMINI_EMBED_MODEL=

# GitHub feed (B4) — optional, raises the rate limit
GITHUB_TOKEN=

# Rate limiting (Upstash Redis). Without these, an in-memory limiter is used (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random strings: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
IP_HASH_SALT=
REVALIDATE_SECRET=
CRON_SECRET=
